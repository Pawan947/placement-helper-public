{
  "name": "placement-helper",
  "version": "1.0.1",
  "description": "Electron dashboard that fetches, tracks, and registers university placement drives from one place.",
  "main": "dashboard/main.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Pawan947/placement-helper-public.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "install-all": "npm install && npm install --prefix dashboard",
    "start": "npm start --prefix dashboard",
    "dev": "npm run dev --prefix dashboard",
    "obfuscate": "node obfuscate.js",
    "build": "node build.js",
    "pack": "npx electron-builder --win --x64 --dir",
    "dist": "npx electron-builder --win --x64",
    "check": "node --check pipeline.js && node --check analytics.js && node --check build.js && node --check obfuscate.js && node --check dashboard/main.js && node --check dashboard/preload.js && node --check dashboard/renderer.js",
    "clean": "node -e \"const fs=require('fs');['dist','build-src'].forEach(d=>{if(fs.existsSync(d))fs.rmSync(d,{recursive:true,force:true});console.log('Cleaned '+d)})\""
  },
  "dependencies": {
    "axios": "^1.9.0",
    "cheerio": "^1.0.0",
    "dotenv": "^16.5.0",
    "electron-updater": "^6.8.9",
    "posthog-node": "^4.0.0"
  },
  "devDependencies": {
    "electron": "^44.7.1",
    "electron-builder": "^26.15.3",
    "javascript-obfuscator": "^5.9.0"
  }
}
